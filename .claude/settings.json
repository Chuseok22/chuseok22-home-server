{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "env": {
    "MAX_THINKING_TOKENS": "10000",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "50"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -c '{hookSpecificOutput: {hookEventName: \"PreToolUse\", updatedInput: {command: (\"export VIRTUAL_ENV=\\\"$PWD/.venv\\\" PATH=\\\"$PWD/.venv/bin:$PATH\\\" && \" + .tool_input.command)}}}'",
            "statusMessage": "venv 활성화 중..."
          }
        ]
      }
    ]
  }
}